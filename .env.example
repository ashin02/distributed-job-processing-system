# Local development only. Choose a non-production password and keep .env uncommitted.
POSTGRES_DB=computegrid
POSTGRES_TEST_DB=computegrid_test
POSTGRES_USER=computegrid
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
RABBITMQ_USER=computegrid
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

COMPUTEGRID_DATABASE_URL=postgresql+psycopg://computegrid:replace-with-a-local-password@localhost:5432/computegrid
COMPUTEGRID_DATABASE_CONNECT_TIMEOUT_SECONDS=5
COMPUTEGRID_TEST_DATABASE_URL=postgresql+psycopg://computegrid:replace-with-a-local-password@localhost:5432/computegrid_test
COMPUTEGRID_BROKER_URL=amqp://computegrid:replace-with-a-local-rabbitmq-password@localhost:5672//
COMPUTEGRID_RABBITMQ_MANAGEMENT_URL=http://localhost:15672
COMPUTEGRID_TEST_BROKER_URL=amqp://computegrid:replace-with-a-local-rabbitmq-password@localhost:5672//
COMPUTEGRID_OPERATIONS_TIMEOUT_SECONDS=2
COMPUTEGRID_JOB_QUEUE=computegrid.jobs
COMPUTEGRID_WORKER_CONCURRENCY=2
COMPUTEGRID_OUTBOX_BATCH_SIZE=50
COMPUTEGRID_OUTBOX_POLL_INTERVAL_SECONDS=1
COMPUTEGRID_JOB_MAX_ATTEMPTS=3
COMPUTEGRID_RETRY_BASE_DELAY_SECONDS=1
COMPUTEGRID_RETRY_MAX_DELAY_SECONDS=300
COMPUTEGRID_RETRY_JITTER_RATIO=0.5
COMPUTEGRID_JOB_LEASE_SECONDS=300
COMPUTEGRID_LEASE_RECOVERY_BATCH_SIZE=50
COMPUTEGRID_WORKER_SOFT_SHUTDOWN_TIMEOUT_SECONDS=30
COMPUTEGRID_DEVELOPMENT_API_TOKEN=replace-with-a-random-development-token
COMPUTEGRID_DEVELOPMENT_CLIENT_ID=local-development
COMPUTEGRID_DEMO_MODE_ENABLED=false
# Deliberately invalid placeholder: replace it before enabling demo mode.
COMPUTEGRID_DEMO_SESSION_SECRET=replace-me
COMPUTEGRID_DEMO_SESSION_TTL_SECONDS=604800
COMPUTEGRID_DEMO_COOKIE_SECURE=false
COMPUTEGRID_DEMO_COOKIE_SAMESITE=lax
COMPUTEGRID_DEMO_SUBMISSION_LIMIT=10
COMPUTEGRID_DEMO_READ_LIMIT=120
COMPUTEGRID_DEMO_OPERATIONS_LIMIT=30
COMPUTEGRID_DEMO_RATE_WINDOW_SECONDS=60
COMPUTEGRID_DEMO_GLOBAL_REQUEST_LIMIT=1000
COMPUTEGRID_DEMO_MAX_ACTIVE_JOBS_PER_CLIENT=3
COMPUTEGRID_DEMO_MAX_ACTIVE_JOBS_GLOBAL=100
COMPUTEGRID_DEMO_MAX_RETAINED_JOBS_PER_CLIENT=50
COMPUTEGRID_DEMO_MAX_RETAINED_JOBS_GLOBAL=5000
COMPUTEGRID_DEMO_MAX_MONTE_CARLO_SAMPLES=1000000
COMPUTEGRID_DEMO_MAX_MODEL_VARIABLES=12
COMPUTEGRID_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
